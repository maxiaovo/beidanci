generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  passwordHash      String
  role              String   @default("user") // admin | user | parent
  avatarUrl         String? // 头像文件名，位于 data/avatars/
  parentId          String? // 孩子的家长（仅 role=user 使用）
  parent            User?    @relation("ParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children          User[]   @relation("ParentChild")
  dailyNewTarget    Int      @default(20)
  dailyReviewTarget Int      @default(100)
  defaultCheckMode  String   @default("spell") // spell | choice
  recoveryCorrectTarget Int  @default(1) // 复习补考需答对次数（1-5，家长可设）
  cyclicRecovery      Boolean @default(false) // 循环补考：补考中再错则已累计次数清零重计
  themePreset       String? // 主题预设 id：macaron | aegean | purple | green | blue | warm | dark | custom
  themeCustom       String? // JSON：{background, foreground, accent, accent2}
  highlightColor    String? // 学习页高亮颜色（hex）
  wordSize          String   @default("big") // 学习页单词字号：big | bigger | biggest
  segmentSize       String   @default("big") // 词根词缀字号
  sentenceSize      String   @default("big") // 例句字号
  sentenceCnSize    String   @default("big") // 例句中文字号
  createdAt         DateTime @default(now())

  books              Book[]
  progresses         WordProgress[]
  logs               StudyLog[]
  assignments        BookAssignment[]
  reviewSkips        ReviewSkip[]
  messages           Message[]
  bookPlans          BookPlan[]
  studyReports       StudyReport[]
  writingProfile     WritingProfile?
  writingSessions    WritingSession[]
  writingAttempts    WritingAttempt[]
  writingMemoryItems WritingMemoryItem[]
}

// 写作能力画像：结构化背景、目标与持续更新的能力证据都保存为 JSON 字符串。
model WritingProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  declaredContext  String    @default("{}")
  goals            String    @default("{}")
  abilityBand      String    @default("")
  abilitySummary   String    @default("")
  dimensions       String    @default("{}")
  strengths        String    @default("[]")
  weaknesses       String    @default("[]")
  evidence         String    @default("[]")
  assessmentStatus String    @default("pending") // pending | provisional | assessed
  completedTasks   Int       @default(0)
  lastAssessedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model WritingSession {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // diagnostic | practice | review
  mode        String // topic | generated | free | translation | imitation | review
  title       String           @default("")
  topic       String           @default("")
  genre       String           @default("")
  target      String           @default("{}")
  status      String           @default("active") // active | completed
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?
  messages    WritingMessage[]
  tasks       WritingTask[]

  @@index([userId, status, updatedAt])
}

model WritingMessage {
  id        String         @id @default(cuid())
  sessionId String
  session   WritingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
}

model WritingTask {
  id           String           @id @default(cuid())
  sessionId    String
  session      WritingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderIndex   Int
  type         String // sentence | paragraph | article | translation | imitation | correction
  prompt       String           @default("{}")
  focus        String           @default("[]")
  status       String           @default("active") // active | passed
  hintLevel    Int              @default(0)
  failedRounds Int              @default(0)
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  attempts     WritingAttempt[]

  @@unique([sessionId, orderIndex])
}

model WritingAttempt {
  id              String              @id @default(cuid())
  taskId          String
  task            WritingTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientRequestId String              @unique
  version         Int
  text            String
  feedback        String              @default("{}")
  passed          Boolean             @default(false)
  usedHint        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  memoryItems     WritingMemoryItem[]

  @@unique([taskId, version])
  @@index([userId, createdAt])
}

model WritingMemoryItem {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAttemptId String
  sourceAttempt   WritingAttempt @relation(fields: [sourceAttemptId], references: [id], onDelete: Cascade)
  category        String
  skillCode       String
  summary         String
  explanation     String         @default("")
  exampleBefore   String         @default("")
  exampleAfter    String         @default("")
  stage           Int            @default(0)
  reps            Int            @default(0)
  lapses          Int            @default(0)
  nextReviewAt    DateTime
  status          String         @default("active") // active | mastered
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status, nextReviewAt])
}

// 学习计划：每本书的每日新词量（按词数或单元分数）
model BookPlan {
  id          String   @id @default(cuid())
  userId      String
  bookId      String
  amountType  String   @default("words") // words | fraction
  wordsPerDay Int      @default(10)
  fractionDen Int      @default(2)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

// 跳过复习留痕：管理员开启"允许跳过"后，学习者当天可跳过复习门禁，每次跳过记一条
// module 区分跳过的是单词复习（words）还是写作复练（writing），两种门禁互不影响
// count 记录跳过时待复习的词数/错点数（这些会累积到下次复习环节）
model ReviewSkip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String   @default("words")
  count     Int      @default(0)
  createdAt DateTime @default(now())
}

// 家长留言：管理员发给指定学习者，有效期内触发展示
model Message {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String
  trigger      String   @default("start") // start | minutes | word
  triggerValue Int? // minutes=学习N分钟后；word=学到第N个词（1 起）
  validUntil   DateTime // 有效期截止；active = now <= validUntil
  createdAt    DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// DeepSeek 生成结果是可复用资源：相同功能、提示词、模型与输入命中同一份产物。
model AiResource {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  featureKey  String
  model       String
  promptHash  String
  inputHash   String
  request     String
  response    String
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsedAt  DateTime @default(now())

  @@index([featureKey, updatedAt])
}

// 首页“每日自然单词”：图片、单词、音标与 TTS 音频由同一资源统一管理。
model DailyWordResource {
  id        String   @id
  daySlot   Int      @unique // 1=周一 … 7=周日
  word      String
  phonetic  String
  category  String   @default("nature") // plant | land | marine | bird
  imageAlt  String   @default("")
  imageFile String
  audioFile String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id            String   @id @default(cuid())
  name          String
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  status        String   @default("ready") // queued | processing | ready | error | stopped | pending_audio
  audioApproved Boolean  @default(false) // 导入音频生成审批：true 后才批量生成音频
  rawUnits      String   @default("[]") // 导入原始单元文本 JSON，断点续传用
  audioDone     Int      @default(0)
  audioTotal    Int      @default(0)
  analyzeDone   Int      @default(0) // AI 分析阶段进度（单元数）
  analyzeTotal  Int      @default(0)
  sharedWithAll Boolean  @default(false) // 分配给所有用户（含未来注册用户）
  createdAt     DateTime @default(now())

  units       Unit[]
  assignments BookAssignment[]
  bookPlans   BookPlan[]
}

model BookAssignment {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bookId, userId])
}

model Unit {
  id         String @id @default(cuid())
  bookId     String
  book       Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int

  words Word[]
}

model Word {
  id         String  @id @default(cuid())
  unitId     String
  unit       Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  orderIndex Int
  text       String
  phonetic   String  @default("")
  pos        String  @default("")
  meaningCn  String  @default("")
  meaningEn  String  @default("")
  segments   String  @default("[]") // JSON: [{part, type, meaningCn}]
  mnemonic   String  @default("")
  example1   String  @default("")
  example1Cn String  @default("")
  example2   String  @default("")
  example2Cn String  @default("")
  audioWord  String? // 文件名，位于 data/audio/
  audioEx1   String?
  audioEx2   String?

  progresses WordProgress[]
  logs       StudyLog[]
  audios     WordAudio[]
}

// 音频版本：每次合成（导入/重新生成）追加一条，Word.audio* 指向当前启用的版本文件
model WordAudio {
  id        String   @id @default(cuid())
  wordId    String
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  kind      String // word | ex1 | ex2
  file      String // 文件名，位于 data/audio/
  voice     String   @default("")
  createdAt DateTime @default(now())

  @@index([wordId, kind])
}

model WordProgress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  wordId       String
  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  stage        Int      @default(0)
  nextReviewAt DateTime
  lastResult   String   @default("") // correct | wrong | giveup
  spellPassed  Boolean  @default(false) // 强检查：本轮拼写检查已通过
  choicePassed Boolean  @default(false) // 强检查：本轮选择检查已通过
  reps         Int      @default(0)
  lapses       Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, wordId])
}

model StudyLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  wordId    String
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  mode      String // learn | check-spell | check-choice
  result    String // correct | wrong | giveup
  attempt   String? // 拼写题答错时的实际作答内容（供学习报告分析错因）
  createdAt DateTime @default(now())
}

// 学习报告：对一段时间内答错/放弃的单词生成错因精讲（DeepSeek）+ 朗读音频（Qwen TTS）
// 异步生成：status 从 generating 推进到 done / failed，step 记录当前阶段供前端轮询展示进度
model StudyReport {
  id         String   @id @default(cuid())
  userId     String // 学习主体（孩子）
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rangeStart DateTime
  rangeEnd   DateTime
  status     String   @default("generating") // generating | done | failed
  step       String   @default("collect") // collect | narrate | tts
  error      String   @default("")
  content    String   @default("") // 精讲正文（markdown）
  spoken     String   @default("") // 朗读稿（TTS 文本）
  audioFile  String? // 文件名，位于 data/reports/
  createdBy  String   @default("") // 触发者 user id（孩子本人或家长）
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
