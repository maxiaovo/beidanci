{
  "name": "vocab-app",
  "version": "0.19.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "build:client": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p 3003",
    "test": "tsx --test tests/**/*.test.ts tests/**/*.test.tsx",
    "test:watch": "tsx --test --watch tests/**/*.test.ts tests/**/*.test.tsx",
    "check:fast": "npm test && npm run lint",
    "check": "npm test && npm run lint && npm run build",
    "lint": "eslint",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
